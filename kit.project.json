{
    "name": "Welcome to Hell Kit",
    "emitLegacyScripts": false,
    "servePlaceIds": [
        113552277431105
    ],
    "globIgnorePaths": [
        "**/package.json",
        "**/tsconfig.json"
    ],
    "tree": {
        "$className": "DataModel",
        "ServerScriptService": {
            "$className": "ServerScriptService",
            "WTHServerCore": {
                "$path": "out/core/server"
            },
            "WTHServerKit": {
                "$path": "out/kit/server"
            }
        },
        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "KitScripts": {
                "$path": "kit/scripts",
                "$ignoreUnknownInstances": true
            },
            "KitTags": {
                "$path": "kit/tags"
            },
            "KitStd": {
                "$path": "kit/std"
            },
            "WTHSharedCore": {
                "$path": "out/core/shared",
                "include": {
                    "$path": "include",
                    "node_modules": {
                        "$className": "Folder",
                        "@rbxts": {
                            "$path": "node_modules/@rbxts"
                        },
                        "@flamework": {
                            "$path": "node_modules/@flamework"
                        }
                    }
                }
            },
            "WTHSharedKit": {
                "$path": "out/kit/shared"
            },
            "WTHClientCore": {
                "$path": "out/core/client"
            },
            "WTHClientKit": {
                "$path": "out/kit/client"
            }
        },
        "Workspace": {
            "$className": "Workspace",
            "$ignoreUnknownInstances": true,
            "$properties": {
                "StreamingEnabled": false,
                "PhysicsSteppingMethod": "Fixed",
                "SignalBehavior": "Immediate"
            },
            "Kit": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true,
                "README": {
                    "$path": "kit/KitReadMe.luau"
                },
                "LICENSE": {
                    "$path": "kit/KitLicense.luau"
                }
            }
        },
        "HttpService": {
            "$className": "HttpService",
            "$properties": {
                "HttpEnabled": true
            }
        },
        "StarterPlayer": {
            "$className": "StarterPlayer",
            "$properties": {
                "GameSettingsAvatar": "R6"
            }
        }
    }
}